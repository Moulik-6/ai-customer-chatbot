# Environment variables template
# Copy this file to .env for local development, or add values as Space secrets for HF Spaces.

# Hugging Face API Configuration (used for remote FLAN-T5 inference fallback)
HUGGINGFACE_API_KEY="your_token_here"
HUGGINGFACE_API_BASE="https://router.huggingface.co/hf-inference/models"

# Model Configuration
# HUGGINGFACE_MODEL: the model used as the final AI fallback (DB + intents are checked first)
MODEL_TYPE="generation"
HUGGINGFACE_MODEL="google/flan-t5-small"
FINETUNED_MODEL_PATH=""  # Optional local path to a fine-tuned model
MOCK_MODE="false"
PORT="7860"
FILE_ENV="production"
USE_LOCAL_MODEL="false"  # Set to "true" to run inference locally instead of via HF API

# Supabase Database Configuration (REQUIRED for products, orders & conversation logging)
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"

# Admin API Key (protects all write and /api/admin/* endpoints)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to run in open/dev mode (no auth required)
ADMIN_API_KEY=""

